"""
Defines targets for interacting with physical Garmin devices.
"""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(
    "//device:defs.bzl",
    "ciq_view_system_log",
)

exports_files(["defs.bzl"])

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//build:defs",
        "@bazel_skylib//lib:paths",
    ],
)

_UNIX_ONLY = select({
    "@platforms//os:linux": [],
    "@platforms//os:osx": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "linux_libmtp",
    linkopts = ["-lmtp"],
    target_compatible_with = _UNIX_ONLY,
)

alias(
    name = "libmtp",
    actual = select({
        "@platforms//os:linux": ":linux_libmtp",
        "@platforms//os:osx": "@osx_homebrew//:libmtp",
        "//conditions:default": "//:libmtp_unsupported",
    }),
    target_compatible_with = _UNIX_ONLY,
    visibility = ["//visibility:public"],
)

rust_library(
    name = "lib",
    srcs = ["lib.rs"],
    deps = [
        "@crates//:clap",
        "@crates//:libc",
    ] + select({
        "@platforms//os:linux": [":libmtp"],
        "@platforms//os:osx": [":libmtp"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "lib_test",
    crate = ":lib",
)

rust_binary(
    name = "upload",
    srcs = ["upload.rs"],
    visibility = ["//visibility:public"],
    deps = [
        ":lib",
    ],
)

rust_binary(
    name = "download",
    srcs = ["download.rs"],
    visibility = ["//visibility:public"],
    deps = [
        ":lib",
    ],
)

rust_binary(
    name = "interpret_profiling_log",
    srcs = ["interpret_profiling_log.rs"],
    deps = [
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:prost",
        "@crates//:xml",
    ],
)

ciq_view_system_log(
    name = "view_system_log",
)
