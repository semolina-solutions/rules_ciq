"""Bazel module for Garmin Connect IQ development tools."""

module(
    name = "rules_ciq",
    version = "0.2.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "stardoc", version = "0.8.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
use_repo(go_sdk, "go_default_sdk")

connect_iq_sdk_manager = use_repo_rule("//:ciq.bzl", "connect_iq_sdk_manager")

connect_iq_sdk_manager(
    name = "connect_iq_sdk_manager_cli",
    commit = "59a5f5fe7e35cef089868b2786c2e3a7f3d27361",
    remote = "https://github.com/semolina-solutions/connect-iq-sdk-manager-cli.git",
)

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "osx_homebrew",
    build_file = "local_repositories/osx_homebrew/BUILD.bazel",
    path = "/opt/homebrew",
)


rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.94.0"],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "anyhow",
    version = "1.0",
)
crate.spec(
    features = ["derive"],
    package = "clap",
    version = "4.4",
)
crate.spec(
    package = "image",
    version = "0.24",
)
crate.spec(
    package = "libc",
    version = "0.2",
)
crate.spec(
    package = "regex",
    version = "1.12.2",
)
crate.spec(
    features = ["full"],
    package = "tokio",
    version = "1.36.0",
)
crate.spec(
    package = "xml",
    version = "1.1.0",
)
crate.spec(
    features = ["derive"],
    package = "prost",
    version = "0.13",
)
crate.spec(
    package = "swash",
    version = "0.1",
)
crate.spec(
    package = "rectangle-pack",
    version = "0.4.2",
)
crate.spec(
    features = ["derive"],
    package = "serde",
    version = "1.0",
)
crate.spec(
    package = "serde_json",
    version = "1.0",
)
crate.from_specs()
use_repo(crate, "crates")

ciq = use_repo_rule("//:ciq.bzl", "ciq")

ciq(name = "ciq")

product_data_api = use_repo_rule("//:product_data_api.bzl", "product_data_api")

product_data_api(
    name = "garmin_product_data",
    devices_json = "@ciq//:devices.json",
)
